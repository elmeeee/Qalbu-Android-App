    <!-- Manzil -->
    <string name="manzil_title">Manzil</string>
    <string name="manzil_subtitle">Ayat perlindungan Al-Quran</string>
    <string name="manzil_account_subtitle">Ayat perlindungan dari Al-Quran</string>
    <string name="manzil_header_title">Perlindungan dari Al-Quran</string>
    <string name="manzil_header_body">Kumpulan ayat pilihan untuk perlindungan dari sihir, jin, dan gangguan, disusun oleh ulama di anak benua India.</string>
    <string name="manzil_verse_range">Surah %1$d · Ayat %2$d%3$s</string>
    <string name="manzil_verses_unavailable">Ayat tidak dapat dimuat.</string>
    <string name="manzil_item_fatihah">Al-Fatihah 1–7</string>
    <string name="manzil_desc_fatihah">Bacaan Manzil dimulai dengan Al-Fatihah — surah teragung, dibaca di setiap rakaat sholat. Penyembuh dan pelindung.</string>
    <string name="manzil_item_baqarah_1">Al-Baqarah 1–5</string>
    <string name="manzil_desc_baqarah_1">Lanjutkan dengan awal Al-Baqarah — petunjuk bagi yang bertakwa dan jalan menuju kesuksesan.</string>
    <string name="manzil_item_baqarah_163">Al-Baqarah 163</string>
    <string name="manzil_desc_baqarah_163">Tuhanmu Maha Esa — tiada tuhan selain Dia, Maha Pengasih, Maha Penyayang.</string>
    <string name="manzil_item_ayat_kursi">Ayat Kursi (Al-Baqarah 255)</string>
    <string name="manzil_desc_ayat_kursi">Ayat teragung dalam Al-Quran — benteng perlindungan. Siapa membacanya di malam hari akan tetap dalam perlindungan Allah hingga pagi.</string>
    <string name="manzil_item_baqarah_256">Al-Baqarah 256</string>
    <string name="manzil_desc_baqarah_256">Tidak ada paksaan dalam agama — kebenaran telah nyata dari kesesatan.</string>
    <string name="manzil_item_baqarah_257">Al-Baqarah 257</string>
    <string name="manzil_desc_baqarah_257">Allah Pelindung orang-orang beriman, mengeluarkan mereka dari kegelapan kepada cahaya.</string>
    <string name="manzil_item_baqarah_284">Al-Baqarah 284</string>
    <string name="manzil_desc_baqarah_284">Milik Allah apa yang di langit dan bumi — Dia akan memperhitungkan apa yang ada di hatimu.</string>
    <string name="manzil_item_baqarah_285">Al-Baqarah 285</string>
    <string name="manzil_desc_baqarah_285">Rasul dan orang beriman beriman pada wahyu — kami dengar dan kami taat, mohon ampunan-Mu.</string>
    <string name="manzil_item_baqarah_286">Al-Baqarah 286</string>
    <string name="manzil_desc_baqarah_286">Allah tidak membebani jiwa melampaui kemampuannya — doa penutup Al-Baqarah memohon ampunan dan pertolongan.</string>
    <string name="manzil_item_ali_imran_18">Ali \'Imran 18</string>
    <string name="manzil_desc_ali_imran_18">Allah bersaksi tiada tuhan selain Dia — Yang Maha Perkasa, Maha Bijaksana.</string>
    <string name="manzil_item_ali_imran_26">Ali \'Imran 26</string>
    <string name="manzil_desc_ali_imran_26">Katakanlah: Wahai Allah, Pemilik kerajaan — Engkau memberi kemuliaan kepada siapa yang Engkau kehendaki.</string>
    <string name="manzil_item_ali_imran_27">Ali \'Imran 27</string>
    <string name="manzil_desc_ali_imran_27">Engkau masukkan malam ke siang dan hidup dari yang mati — Engkau memberi rezeki tanpa hisab.</string>
    <string name="manzil_item_al_araf">Al-A\'raf 54–56</string>
    <string name="manzil_desc_al_araf">Tuhanmu menciptakan langit dan bumi dalam enam masa — serulah Dia dengan rendah hati dan sembunyi.</string>
    <string name="manzil_item_al_isra">Al-Isra\' 110–111</string>
    <string name="manzil_desc_al_isra">Serulah Allah atau Ar-Rahman — milik-Nya Nama-Nama Terindah. Segala puji bagi-Nya yang tidak beranak dan tidak bersekutu.</string>
    <string name="manzil_item_al_muminun">Al-Mu\'minun 115–118</string>
    <string name="manzil_desc_al_muminun">Apakah kamu diciptakan tanpa tujuan? Maha Tinggi Allah, Raja Sejati — mohon ampunan dan rahmat-Nya.</string>
    <string name="manzil_item_ash_shaffat">Ash-Shaffat 1–11</string>
    <string name="manzil_desc_ash_shaffat">Demi malaikat yang berbaris dalam saf — Tuhanmu Maha Esa, Rabb langit dan bumi.</string>
    <string name="manzil_item_ar_rahman">Ar-Rahman 33–40</string>
    <string name="manzil_desc_ar_rahman">Wahai jin dan manusia — tiada yang lolos dari kekuasaan Allah. Maka nikmat Tuhanmu yang manakah yang kamu dustakan?</string>
    <string name="manzil_item_al_hasyr">Al-Hasyr 21–24</string>
    <string name="manzil_desc_al_hasyr">Jika Quran ini diturunkan ke atas gunung, niscaya ia akan runtuh — Dialah Allah, Pencipta, Pembentuk Rupa, Nama-Nama Terindah.</string>
    <string name="manzil_item_al_jinn">Al-Jinn 1–4</string>
    <string name="manzil_desc_al_jinn">Serombongan jin mendengar Quran, beriman, dan menyatakan iman mereka — Tuhan kami tidak beristri dan tidak beranak.</string>
    <string name="manzil_item_al_kafirun">Al-Kafirun 1–6</string>
    <string name="manzil_desc_al_kafirun">Pernyataan pemutusan dari kekafiran — bagimu agamamu, bagiku agamaku.</string>
    <string name="manzil_item_al_ikhlas">Al-Ikhlas 1–4</string>
    <string name="manzil_desc_al_ikhlas">Intisari Tauhid — Dialah Allah, Maha Esa, Tempat Bergantung, tidak beranak dan tidak dilahirkan.</string>
    <string name="manzil_item_al_falaq">Al-Falaq 1–5</string>
    <string name="manzil_desc_al_falaq">Berlindung kepada Tuhan Subuh dari kejahatan makhluk, malam gelap, sihir, dan iri hati.</string>
    <string name="manzil_item_an_nas">An-Nas 1–6</string>
    <string name="manzil_desc_an_nas">Berlindung kepada Tuhan manusia, Raja manusia, dari bisikan setan yang bersembunyi.</string>

    <!-- Manzil Info Card -->
    <string name="manzil_info_title">Tentang Manzil Al-Quran</string>
    <string name="manzil_info_subtitle">Definisi, pembagian 7 hari &amp; panduan amalan</string>
    <string name="manzil_info_definition">Manzil (bahasa Arab: منزل) adalah sistem pembagian pembacaan Al-Quran untuk memudahkan penyelesaian (khataman) Al-Quran selama tujuh hari (seminggu). Tradisi ini umum dipraktikkan di komunitas Muslim Asia Selatan dan dipopulerkan oleh ulama seperti Syah Waliullah al-Dahlawi.\n\nCatatan: "Manzil" di sini merujuk pada pembagian 7 bagian Al-Quran untuk khataman, berbeda dari ayat-ayat ruqyah perlindungan (Manzil ruqyah) yang dikumpulkan oleh Maulana Zakariyya Kandhlawi. Bagian ini dalam aplikasi membahas ayat-ayat perlindungan.</string>
    <string name="manzil_fami_label">Fami bi Syauqin (فَمِي بِشَوْقٍ)</string>
    <string name="manzil_fami_desc">Ungkapan kunci yang berarti "mulutku selalu rindu (membaca Al-Quran)". Tujuh huruf — ف م ي ب ش و ق — adalah huruf awal dari surah yang memulai setiap Manzil: Al-Fatihah, Al-Ma\'idah, Yunus, Al-Isra\', Asy-Syu\'ara, Ash-Shaffat, dan Qaf.</string>
    <string name="manzil_table_title">Pembagian Manzil 7 Hari</string>
    <string name="manzil_col_manzil">Manzil</string>
    <string name="manzil_col_juz">Juz</string>
    <string name="manzil_col_surah">Rentang Surah</string>
    <string name="manzil_row_1_letter">١ — ف (fa\')</string>
    <string name="manzil_row_1_juz">Juz 1–6</string>
    <string name="manzil_row_1_surah">Al-Fatihah – An-Nisa\'</string>
    <string name="manzil_row_2_letter">٢ — م (mim)</string>
    <string name="manzil_row_2_juz">Juz 6–11</string>
    <string name="manzil_row_2_surah">Al-Ma\'idah – At-Taubah</string>
    <string name="manzil_row_3_letter">٣ — ي (ya\')</string>
    <string name="manzil_row_3_juz">Juz 11–14</string>
    <string name="manzil_row_3_surah">Yunus – An-Nahl</string>
    <string name="manzil_row_4_letter">٤ — ب (ba\')</string>
    <string name="manzil_row_4_juz">Juz 15–19</string>
    <string name="manzil_row_4_surah">Al-Isra\' – Al-Furqan</string>
    <string name="manzil_row_5_letter">٥ — ش (syin)</string>
    <string name="manzil_row_5_juz">Juz 19–23</string>
    <string name="manzil_row_5_surah">Asy-Syu\'ara – Yasin</string>
    <string name="manzil_row_6_letter">٦ — و (wau)</string>
    <string name="manzil_row_6_juz">Juz 23–26</string>
    <string name="manzil_row_6_surah">Ash-Shaffat – Al-Hujurat</string>
    <string name="manzil_row_7_letter">٧ — ق (qaf)</string>
    <string name="manzil_row_7_juz">Juz 26–30</string>
    <string name="manzil_row_7_surah">Qaf – An-Nas</string>
    <string name="manzil_how_title">Cara Mengamalkan</string>
    <string name="manzil_how_body">Setiap hari, bacalah satu Manzil secara berurutan dari Senin hingga Minggu, sehingga khatam Al-Quran dalam satu minggu. Boleh dibaca dalam satu dudukan atau dibagi dalam beberapa sesi sepanjang hari (misalnya setelah Subuh, Zuhur, Asar, Maghrib, dan Isya\').\n\nUntuk memulai, bacalah Manzil 1 (Juz 1–6) dan lanjutkan ke Manzil berikutnya setiap hari. Istiqamah adalah kuncinya — meskipun tidak bisa menyelesaikan satu Manzil penuh dalam sehari, usahakan minimal membaca sebagian dan lanjutkan keesokan harinya.</string>
    <string name="manzil_benefits_title">Keutamaan &amp; Manfaat</string>
    <string name="manzil_benefits_list">Memungkinkan khataman Al-Quran secara rutin — satu kali per minggu.|Membangun hubungan yang kuat dan konsisten dengan Kitab Allah.|Membaca keseluruhan Al-Quran secara teratur mendatangkan pahala yang besar dan ampunan.|Mendorong tadabbur harian pada berbagai bagian Al-Quran.|Pendekatan terstruktur yang direkomendasikan oleh ulama klasik dan diwariskan turun-temurun.</string>

