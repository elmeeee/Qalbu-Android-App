    <string name="tahajud_guide_intro">Buka setiap bagian untuk teks Arab, transliterasi, dan panduan langkah demi langkah tahajud / qiyam.</string>
    <string name="tahajud_cat_preparation">Persiapan</string>
    <string name="tahajud_cat_prayer">Sholat (2 rakaat berpasang)</string>
