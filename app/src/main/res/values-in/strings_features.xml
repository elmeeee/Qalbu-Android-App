    <string name="tahajud_cat_closing">Setelah sholat</string>
    <string name="tahajud_when_title">Waktu terbaik — sepertiga malam terakhir</string>
    <string name="tahajud_when_body">Tidur dengan niat bangun untuk tahajud. Sepertiga malam terakhir (antara Isya dan Subuh) sangat mulia. Bahkan dua rakaat sebelum Subuh termasuk tahajud.</string>
    <string name="tahajud_niat_title">Niat</string>
    <string name="tahajud_niat_body">Berniat di hati sebelum takbir. Contoh: Aku niat sholat sunnah tahajud karena Allah.</string>
    <string name="tahajud_niat_arabic">نَوَيْتُ أَنْ أُصَلِّيَ سُنَّةَ التَّهَجُّدِ لِلَّهِ تَعَالَى</string>
    <string name="tahajud_niat_translit">Nawaytu an usalliya sunnata at-tahajjudi lillāhi taʿālā</string>
    <string name="tahajud_takbir_title">Takbiratul ihram</string>
    <string name="tahajud_takbir_body">Angkat tangan dan ucapkan Allahu Akbar untuk memulai setiap pasang rakaat. Hadap kiblat dengan wudu.</string>
    <string name="tahajud_takbir_arabic">اللَّهُ أَكْبَرُ</string>
    <string name="tahajud_takbir_translit">Allāhu akbar</string>
    <string name="tahajud_iftitah_title">Doa iftitah (opsional)</string>
    <string name="tahajud_iftitah_body">Setelah takbir, boleh membaca doa pembuka sebelum Al-Fatihah di rakaat pertama.</string>
    <string name="tahajud_iftitah_arabic">سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ، وَتَبَارَكَ اسْمُكَ، وَتَعَالَى جَدُّكَ، وَلَا إِلَٰهَ غَيْرُكَ</string>
    <string name="tahajud_iftitah_translit">Subḥānaka Allāhumma wa biḥamdika, wa tabāraka smuka, wa taʿālā jadduka, wa lā ilāha ghayruk</string>
    <string name="tahajud_fatihah_title">Al-Fatihah</string>
    <string name="tahajud_fatihah_body">Baca Al-Fatihah di setiap rakaat, lalu surah pendek atau beberapa ayat di dua rakaat pertama setiap pasang.</string>
    <string name="tahajud_surah_title">Surah pendek (contoh)</string>
    <string name="tahajud_surah_body">Pilihan umum: Al-Ikhlas, Al-Falaq, An-Nas, Al-Kafirun, atau surah yang Anda hafal. Tahajud dilakukan berpasang dua rakaat — salam setelah setiap dua.</string>
    <string name="tahajud_ruku_title">Ruku</string>
    <string name="tahajud_ruku_body">Rukuk dengan punggung lurus, tangan di lutut. Ucapkan tasbih minimal 3 kali.</string>
    <string name="tahajud_ruku_arabic">سُبْحَانَ رَبِّيَ الْعَظِيمِ</string>
    <string name="tahajud_ruku_translit">Subḥāna rabbiyal ʿaẓīm</string>
    <string name="tahajud_sujud_title">Sujud</string>
    <string name="tahajud_sujud_body">Sujud dengan dahi, hidung, tangan, lutut, dan jari kaki menyentuh tanah. Ucapkan tasbih minimal 3 kali per sujud.</string>
    <string name="tahajud_sujud_arabic">سُبْحَانَ رَبِّيَ الْأَعْلَى</string>
    <string name="tahajud_sujud_translit">Subḥāna rabbiyal aʿlā</string>
    <string name="tahajud_witr_title">Witir (penutup ganjil)</string>
    <string name="tahajud_witr_body">Akhiri malam dengan witir — minimal 1 rakaat, umumnya 3. Di rakaat terakhir, angkat tangan untuk qunut sebelum ruku (sesuai mazhab). Setelah witir, tidak sholat sunnah lagi.</string>
    <string name="tahajud_qunut_title">Doa qunut (witir)</string>
    <string name="tahajud_qunut_body">Baca qunut di rakaat terakhir witir sambil berdiri, sebelum ruku. Banyak ulama memperbolehkan doa pendek jika hafalan penuh sulit.</string>
    <string name="tahajud_qunut_arabic">اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ، وَعَافِنِي فِيمَنْ عَافَيْتَ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ</string>
    <string name="tahajud_qunut_translit">Allāhumma ihdinī fīman hadayta, wa ʿāfinī fīman ʿāfayta, wa tawallanī fīman tawallayta, wa bārik lī fīmā aʿṭayta</string>
    <string name="tahajud_dhikr_title">Dzikir setelah sholat</string>
    <string name="tahajud_dhikr_body">Setelah salam: Astaghfirullah ×3, Allahumma antas salam…, lalu 33× SubhanAllah, 33× Alhamdulillah, 33× Allahu Akbar.</string>
    <string name="tahajud_dua_title">Doa pribadi</string>
    <string name="tahajud_dua_body">Sepertiga malam terakhir adalah waktu Allah turun (dengan sifat-Nya) dan mengabulkan doa. Mohon ampun, petunjuk, keluarga, dan umat. Berdoa dari hati dalam bahasa apa pun.</string>
