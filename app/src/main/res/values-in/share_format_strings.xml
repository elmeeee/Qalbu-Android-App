    <string name="share_reminder_morning_1">mulailah hari dengan kejernihan sebelum kamu menyerap setiap suara di sekitarmu.</string>
    <string name="share_reminder_morning_2">tanamkan niat sejak pagi: verifikasi sebelum percaya, dan renungkan sebelum bereaksi.</string>
    <string name="share_reminder_morning_3">jadikan ayat ini jangkar pikiranmu sebelum kesibukan datang.</string>
    <string name="share_reminder_afternoon_1">berhenti sejenak di tengah hari dan luruskan kembali hatimu pada kebenaran.</string>
    <string name="share_reminder_afternoon_2">jaga kedamaianmu dengan menyaring apa yang kamu dengar dan ulang.</string>
    <string name="share_reminder_afternoon_3">biarkan ayat ini menghentikan asumsi dan mengembalikan kejernihan.</string>
    <string name="share_reminder_evening_1">sebelum hari berakhir, kembalikan hatimu pada kebenaran dan kerendahan hati.</string>
    <string name="share_reminder_evening_2">perlambat langkah malam ini dan lepaskan kesimpulan yang dibentuk tanpa kepastian.</string>
    <string name="share_reminder_evening_3">biarkan ayat ini membersihkan kebisingan hari ini sebelum masuk ke hatimu.</string>
    <string name="share_reminder_night_1">sebelum tidur, tinggalkan gosip dan pegang teguh apa yang jelas.</string>
    <string name="share_reminder_night_2">akhiri malam dengan renungan, bukan asumsi.</string>
    <string name="share_reminder_night_3">jadikan ayat ini filter terakhir sebelum kamu beristirahat.</string>

