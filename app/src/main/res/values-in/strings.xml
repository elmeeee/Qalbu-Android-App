    <string name="tajweed_idgham_without_ghunna_desc">Memasukkan huruf ke huruf berikutnya tanpa dengung.</string>
    <string name="tajweed_idgham_with_ghunna_title">Idgham Bighunnah</string>
    <string name="tajweed_idgham_with_ghunna_desc">Memasukkan huruf ke huruf berikutnya dengan dengung (2 harakat).</string>
    <string name="tajweed_idgham_mimi_title">Idgham Mimi (Mutamasilain)</string>
    <string name="tajweed_idgham_mimi_desc">Pertemuan huruf Mim sukun dengan Mim, dibaca berdengung (2 harakat).</string>
    <string name="tajweed_iqlab_title">Iqlab</string>
    <string name="tajweed_iqlab_desc">Mengganti bunyi Nun sukun/Tanwin menjadi Mim samar disertai dengung.</string>
    <string name="tajweed_ikhfa_title">Ikhfa Haqiqi</string>
    <string name="tajweed_ikhfa_desc">Membaca Nun sukun/Tanwin secara samar (antara idzhar &amp; idgham) dengan dengung.</string>
