<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Base XML theme used by the Activity window before Compose attaches.
        Compose owns the runtime theming via SaatTheme.
    -->
    <style name="Theme.Saat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/al_khatib_screen_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <!-- Splash screen: gradient bg with centered logo icon.
         Works on API 30+ via compat library and API 31+ via platform. -->
    <style name="Theme.Saat.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@drawable/splash_gradient_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_wrapper</item>
        <item name="android:windowBackground">@drawable/splash_gradient_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Saat</item>
    </style>
</resources>
