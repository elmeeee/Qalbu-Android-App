    <string name="tahajud_when_title">Waktu terbaik — sepertiga malam terakhir</string>
    <string name="tahajud_when_body">Tidur dengan niat bangun untuk tahajud. Sepertiga malam terakhir (antara Isyak dan Subuh) sangat mulia. Walaupun dua rakaat sebelum Subuh dikira tahajud.</string>
    <string name="tahajud_niat_title">Niat</string>
    <string name="tahajud_niat_body">Berniat dalam hati sebelum takbir. Contoh: Aku niat solat sunat tahajud kerana Allah.</string>
    <string name="tahajud_niat_arabic">نَوَيْتُ أَنْ أُصَلِّيَ سُنَّةَ التَّهَجُّدِ لِلَّهِ تَعَالَى</string>
    <string name="tahajud_niat_translit">Nawaytu an usalliya sunnata at-tahajjudi lillāhi taʿālā</string>
    <string name="tahajud_takbir_title">Takbiratul ihram</string>
    <string name="tahajud_takbir_body">Angkat tangan dan sebut Allahu Akbar untuk memulakan setiap pasangan rakaat. Hadap kiblat dengan wuduk.</string>
    <string name="tahajud_takbir_arabic">اللَّهُ أَكْبَرُ</string>
    <string name="tahajud_takbir_translit">Allāhu akbar</string>
    <string name="tahajud_iftitah_title">Doa iftitah (pilihan)</string>
    <string name="tahajud_iftitah_body">Selepas takbir, boleh baca doa pembuka sebelum Al-Fatihah dalam rakaat pertama.</string>
    <string name="tahajud_iftitah_arabic">سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ، وَتَبَارَكَ اسْمُكَ، وَتَعَالَى جَدُّكَ، وَلَا إِلَٰهَ غَيْرُكَ</string>
    <string name="tahajud_iftitah_translit">Subḥānaka Allāhumma wa biḥamdika, wa tabāraka smuka, wa taʿālā jadduka, wa lā ilāha ghayruk</string>
    <string name="tahajud_fatihah_title">Al-Fatihah</string>
    <string name="tahajud_fatihah_body">Baca Al-Fatihah dalam setiap rakaat, kemudian surah pendek atau beberapa ayat dalam dua rakaat pertama setiap pasangan.</string>
    <string name="tahajud_surah_title">Surah pendek (contoh)</string>
    <string name="tahajud_surah_body">Pilihan biasa: Al-Ikhlas, Al-Falaq, An-Nas, Al-Kafirun, atau surah yang anda hafal. Tahajud dilakukan berpasangan dua rakaat — salam selepas setiap dua.</string>
    <string name="tahajud_ruku_title">Rukuk</string>
    <string name="tahajud_ruku_body">Rukuk dengan belakang lurus, tangan di lutut. Sebut tasbih sekurang-kurangnya 3 kali.</string>
    <string name="tahajud_ruku_arabic">سُبْحَانَ رَبِّيَ الْعَظِيمِ</string>
    <string name="tahajud_ruku_translit">Subḥāna rabbiyal ʿaẓīm</string>
    <string name="tahajud_sujud_title">Sujud</string>
    <string name="tahajud_sujud_body">Sujud dengan dahi, hidung, tangan, lutut, dan jari kaki menyentuh tanah. Sebut tasbih sekurang-kurangnya 3 kali setiap sujud.</string>
    <string name="tahajud_sujud_arabic">سُبْحَانَ رَبِّيَ الْأَعْلَى</string>
    <string name="tahajud_sujud_translit">Subḥāna rabbiyal aʿlā</string>
    <string name="tahajud_witr_title">Witir (penutup ganjil)</string>
    <string name="tahajud_witr_body">Akhiri malam dengan witir — minimum 1 rakaat, biasanya 3. Dalam rakaat terakhir, angkat tangan untuk qunut sebelum rukuk (mengikut mazhab). Selepas witir, tidak solat sunat lagi.</string>
    <string name="tahajud_qunut_title">Doa qunut (witir)</string>
    <string name="tahajud_qunut_body">Baca qunut dalam rakaat terakhir witir sambil berdiri, sebelum rukuk. Ramai ulama membenarkan doa pendek jika hafalan penuh sukar.</string>
    <string name="tahajud_qunut_arabic">اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ، وَعَافِنِي فِيمَنْ عَافَيْتَ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ</string>
    <string name="tahajud_qunut_translit">Allāhumma ihdinī fīman hadayta, wa ʿāfinī fīman ʿāfayta, wa tawallanī fīman tawallayta, wa bārik lī fīmā aʿṭayta</string>
    <string name="tahajud_dhikr_title">Zikir selepas solat</string>
    <string name="tahajud_dhikr_body">Selepas salam: Astaghfirullah ×3, Allahumma antas salam…, kemudian 33× SubhanAllah, 33× Alhamdulillah, 34× Allahu Akbar (atau gabungan 100).</string>
    <string name="tahajud_dua_title">Doa peribadi</string>
    <string name="tahajud_dua_body">Sepertiga malam terakhir ialah waktu Allah turun (dengan sifat-Nya) dan mengabulkan doa. Mohon keampunan, petunjuk, keluarga, dan umat. Berdoa dari hati dalam apa jua bahasa.</string>
