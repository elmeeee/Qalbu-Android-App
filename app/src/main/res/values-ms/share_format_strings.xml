    <string name="share_reminder_morning_1">mulakan hari dengan kejelasan sebelum anda menyerap setiap suara di sekeliling.</string>
    <string name="share_reminder_morning_2">tanam niat awal: sahkan sebelum percaya, dan renung sebelum bertindak balas.</string>
    <string name="share_reminder_morning_3">jadikan ayat ini sauh minda sebelum kesibukan bermula.</string>
    <string name="share_reminder_afternoon_1">berhenti sejenak di tengah hari dan luruskan semula hati pada kebenaran.</string>
    <string name="share_reminder_afternoon_2">jaga ketenangan dengan menapis apa yang anda dengar dan ulang.</string>
    <string name="share_reminder_afternoon_3">biarkan ayat ini hentikan andaian dan pulihkan kejelasan.</string>
    <string name="share_reminder_evening_1">sebelum hari berakhir, kembalikan hati pada kebenaran dan kerendahan diri.</string>
    <string name="share_reminder_evening_2">perlahankan langkah malam ini dan lepaskan kesimpulan tanpa kepastian.</string>
    <string name="share_reminder_evening_3">biarkan ayat ini bersihkan kebisingan hari sebelum masuk ke hati.</string>
    <string name="share_reminder_night_1">sebelum tidur, tinggalkan khabar angin dan pegang apa yang jelas.</string>
    <string name="share_reminder_night_2">akhiri malam dengan renungan, bukan andaian.</string>
    <string name="share_reminder_night_3">jadikan ayat ini penapis terakhir sebelum rehat.</string>

