<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_live_activity_card"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical">

    <!-- Left Circle Icon Badge -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_live_circle_badge">

        <ImageView
            android:id="@+id/iv_collapsed_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_live_mosque"
            android:contentDescription="Prayer Icon" />
    </FrameLayout>

    <!-- Center Text Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tv_collapsed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menuju Dzuhur"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_collapsed_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Dzuhur • 11:54"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right Chronometer -->
    <Chronometer
        android:id="@+id/chronometer_countdown_collapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:countDown="true" />

</LinearLayout>
