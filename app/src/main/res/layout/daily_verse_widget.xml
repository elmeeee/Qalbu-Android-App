<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verse_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_prayer_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <View
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:background="@drawable/widget_accent_bar" />

    <TextView
        android:id="@+id/verse_widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="#E8D5A3"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/verse_widget_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/verse_widget_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textDirection="rtl" />

    <TextView
        android:id="@+id/verse_widget_excerpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.9"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="#D9FFFFFF"
        android:textSize="12sp" />

</LinearLayout>
