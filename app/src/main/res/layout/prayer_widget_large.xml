<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Top Row: Ring Icon + Countdown Info -->
    <LinearLayout
        android:id="@+id/widget_large_top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Circular Ring Icon Badge -->
        <FrameLayout
            android:id="@+id/widget_large_ring_container"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_widget_ring_emerald">

            <ImageView
                android:id="@+id/widget_large_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_live_mosque"
                android:contentDescription="Icon" />
        </FrameLayout>

        <!-- Center Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/widget_large_countdown_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menuju Dzuhur"
                android:textColor="#D1D5DB"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <Chronometer
                android:id="@+id/widget_large_countdown_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:countDown="true" />

            <TextView
                android:id="@+id/widget_large_countdown_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:54"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

    <!-- Spacer / Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#1A2F25" />

    <!-- Bottom Row: 6 Prayer Slots -->
    <LinearLayout
        android:id="@+id/widget_large_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Slot 1: Imsak -->
        <LinearLayout
            android:id="@+id/widget_large_slot_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_large_icon_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_imsak"
                android:contentDescription="Imsak" />

            <TextView
                android:id="@+id/widget_large_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Imsak"
                android:textColor="#D1D5DB"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_large_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="04:35"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Slot 2: Subuh -->
        <LinearLayout
            android:id="@+id/widget_large_slot_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_large_icon_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_subuh"
                android:contentDescription="Subuh" />

            <TextView
                android:id="@+id/widget_large_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Subuh"
                android:textColor="#D1D5DB"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_large_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="04:45"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Slot 3: Dzuhur -->
        <LinearLayout
            android:id="@+id/widget_large_slot_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_large_icon_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_dzuhur"
                android:contentDescription="Dzuhur" />

            <TextView
                android:id="@+id/widget_large_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dzuhur"
                android:textColor="#15AA7C"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_large_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="11:54"
                android:textColor="#15AA7C"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Slot 4: Ashar -->
        <LinearLayout
            android:id="@+id/widget_large_slot_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_large_icon_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_ashar"
                android:contentDescription="Ashar" />

            <TextView
                android:id="@+id/widget_large_name_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ashar"
                android:textColor="#D1D5DB"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_large_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="15:12"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Slot 5: Maghrib -->
        <LinearLayout
            android:id="@+id/widget_large_slot_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_large_icon_5"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_maghrib"
                android:contentDescription="Maghrib" />

            <TextView
                android:id="@+id/widget_large_name_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Maghrib"
                android:textColor="#D1D5DB"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_large_time_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="18:11"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Slot 6: Isya -->
        <LinearLayout
            android:id="@+id/widget_large_slot_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_large_icon_6"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_isya"
                android:contentDescription="Isya" />

            <TextView
                android:id="@+id/widget_large_name_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Isya"
                android:textColor="#D1D5DB"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_large_time_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="19:23"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
