<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_times_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- Slot 1: Imsak -->
    <LinearLayout
        android:id="@+id/widget_times_slot_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_times_icon_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_imsak"
            android:contentDescription="Imsak" />

        <TextView
            android:id="@+id/widget_times_name_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Imsak"
            android:textColor="#D1D5DB"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_times_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="04:35"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Slot 2: Subuh -->
    <LinearLayout
        android:id="@+id/widget_times_slot_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
