<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Left Circle Badge -->
    <FrameLayout
        android:id="@+id/widget_med_icon_container"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_live_circle_badge">

        <ImageView
            android:id="@+id/widget_med_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_live_mosque"
            android:contentDescription="Icon" />
    </FrameLayout>

    <!-- Center Text Area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp">

        <!-- Countdown State -->
        <LinearLayout
            android:id="@+id/widget_med_state_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/widget_med_countdown_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dzuhur"
                android:textColor="#D1D5DB"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <Chronometer
                android:id="@+id/widget_med_countdown_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:countDown="true" />

            <TextView
                android:id="@+id/widget_med_countdown_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:54"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Arrived State -->
        <LinearLayout
            android:id="@+id/widget_med_state_arrived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_med_arrived_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saatnya Shalat"
                android:textColor="#D1D5DB"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_med_arrived_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                android:text="Dzuhur"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_med_arrived_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:54"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Finished State -->
        <LinearLayout
            android:id="@+id/widget_med_state_finished"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_med_finished_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dzuhur selesai"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_med_finished_next_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Berikutnya"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_med_finished_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Ashar • 15:12"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right Side (Optional Bell Badge for Arrived State) -->
    <FrameLayout
        android:id="@+id/widget_med_arrived_bell"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_live_circle_badge"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_live_bell"
            android:contentDescription="Bell" />
    </FrameLayout>

</LinearLayout>
