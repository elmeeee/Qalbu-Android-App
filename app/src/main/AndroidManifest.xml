<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- API 33+: USE_EXACT_ALARM is auto-granted at install. API 31–32: SCHEDULE_EXACT_ALARM requires user grant. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".SaatApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saat"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name_launcher"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Saat.Splash"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true">
            <intent-filter android:label="@string/app_name_launcher">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="saat" android:host="quran" />
                <data android:scheme="saat" android:host="mushaf" />
                <data android:scheme="saat" android:host="today" />
                <data android:scheme="saat" android:host="bookmarks" />
                <data android:scheme="saat" android:host="qibla" />
                <data android:scheme="saat" android:host="dhikr" />
                <data android:scheme="saat" android:host="zakat" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Dedicated lightweight Activity for the adhan full-screen alarm overlay.
            showWhenLocked + turnScreenOn are the reliable way to appear above the lock
            screen on API 27+ without requiring FLAG_DISMISS_KEYGUARD.
            excludeFromRecents keeps it out of the recent-apps switcher.
            singleInstance ensures only one alarm screen exists at a time.
        -->
        <activity
            android:name=".AdhanAlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.Saat"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <receiver
            android:name=".infrastructure.notifications.DailyVerseNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name=".infrastructure.notifications.PrayerNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name=".infrastructure.notifications.PrayerAlarmRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".infrastructure.notifications.PrayerMidnightRefreshReceiver"
            android:exported="false" />

        <receiver
            android:name=".infrastructure.notifications.PrayerCheckReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".infrastructure.notifications.SurahReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.kamy.saatApp.ACTION_SURAH_REMINDER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".infrastructure.audio.AdhanStopReceiver"
            android:exported="false" />

        <service
            android:name=".infrastructure.audio.AdhanPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />



        <receiver
            android:name=".infrastructure.widget.WidgetRefreshReceiver"
            android:exported="false" />

        <receiver
            android:name=".infrastructure.widget.DailyVerseWidgetProvider"
            android:exported="true"
            android:label="@string/daily_verse_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_verse_widget_info" />
        </receiver>

        <receiver
            android:name=".infrastructure.widget.PrayerNextWidgetProvider"
            android:exported="true"
            android:label="@string/prayer_widget_next_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_next_widget_info" />
        </receiver>

        <service
            android:name=".infrastructure.audio.RecitationPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable WorkManager androidx.startup auto-init so a DB failure can never
             crash the app at provider install time. Initialized manually in Application. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
