"manzil_benefits_list" = "Membolehkan khatam Al-Quran secara rutin — sekali seminggu.|Membina hubungan yang kukuh dan konsisten dengan Kitab Allah.|Membaca keseluruhan Al-Quran secara tetap mendatangkan pahala yang besar dan keampunan.|Menggalakkan tadabbur harian pada bahagian-bahagian Al-Quran yang berbeza.|Pendekatan berstruktur yang disyorkan oleh ulama klasik dan diwarisi turun-temurun.";
"manzil_benefits_title" = "Kelebihan & Faedah";
"manzil_col_juz" = "Juz";
"manzil_col_manzil" = "Manzil";
"manzil_col_surah" = "Julat Surah";
"manzil_desc_al_araf" = "Tuhanmu menciptakan langit dan bumi dalam enam masa — serulah Dia dengan rendah hati dan tersembunyi.";
"manzil_desc_al_falaq" = "Berlindung kepada Tuhan Waktu Subuh daripada kejahatan makhluk, malam gelap, sihir, dan iri hati.";
"manzil_desc_al_hasyr" = "Jika Quran ini diturunkan ke atas gunung, nescaya ia akan runtuh — Dialah Allah, Pencipta, Pembentuk Rupa, Nama-Nama Terindah.";
"manzil_desc_al_ikhlas" = "Intisari Tauhid — Dialah Allah, Maha Esa, Tempat Bergantung, tidak beranak dan tidak diperanakkan.";
"manzil_desc_al_isra" = "Serulah Allah atau Ar-Rahman — milik-Nya Nama-Nama Terindah. Segala puji bagi-Nya yang tidak beranak dan tidak bersekutu.";
"manzil_desc_al_jinn" = "Sekumpulan jin mendengar Quran, beriman, dan menyatakan iman mereka — Tuhan kami tidak beristeri dan tidak beranak.";
"manzil_desc_al_kafirun" = "Pernyataan pemutusan daripada kekufuran — bagimu agamamu, bagiku agamaku.";
"manzil_desc_al_muminun" = "Adakah kamu diciptakan tanpa tujuan? Maha Tinggi Allah, Raja Sejati — mohon keampunan dan rahmat-Nya.";
"manzil_desc_ali_imran_18" = "Allah bersaksi tiada tuhan selain Dia — Yang Maha Perkasa, Maha Bijaksana.";
"manzil_desc_ali_imran_26" = "Katakanlah: Wahai Allah, Pemilik kerajaan — Engkau memuliakan sesiapa yang Engkau kehendaki.";
"manzil_desc_ali_imran_27" = "Engkau masukkan malam ke siang dan hidup daripada yang mati — Engkau memberi rezeki tanpa hisab.";
"manzil_desc_an_nas" = "Berlindung kepada Tuhan manusia, Raja manusia, daripada bisikan syaitan yang bersembunyi.";
"manzil_desc_ar_rahman" = "Wahai jin dan manusia — tiada yang boleh lolos daripada kekuasaan Allah. Maka nikmat Tuhanmu yang manakah yang kamu dustakan?";
"manzil_desc_ash_shaffat" = "Demi malaikat yang berbaris dalam saf — Tuhanmu Maha Esa, Rabb langit dan bumi.";
"manzil_desc_ayat_kursi" = "Ayat teragung dalam Al-Quran — benteng perlindungan. Sesiapa membacanya pada waktu malam akan kekal dalam perlindungan Allah hingga pagi.";
"manzil_desc_baqarah_1" = "Sambung dengan awal Al-Baqarah — petunjuk bagi yang bertakwa dan jalan menuju kejayaan.";
"manzil_desc_baqarah_163" = "Tuhanmu Maha Esa — tiada tuhan selain Dia, Maha Pengasih, Maha Penyayang.";
"manzil_desc_baqarah_256" = "Tiada paksaan dalam agama — kebenaran telah nyata daripada kesesatan.";
"manzil_desc_baqarah_257" = "Allah Pelindung orang-orang beriman, mengeluarkan mereka daripada kegelapan kepada cahaya.";
"manzil_desc_baqarah_284" = "Milik Allah apa yang di langit dan bumi — Dia akan memperhitungkan apa yang ada di hati kamu.";
"manzil_desc_baqarah_285" = "Rasul dan orang beriman beriman pada wahyu — kami dengar dan kami taat, mohon keampunan-Mu.";
"manzil_desc_baqarah_286" = "Allah tidak membebankan jiwa melampaui kemampuannya — doa penutup Al-Baqarah memohon keampunan dan pertolongan.";
"manzil_desc_fatihah" = "Bacaan Manzil dimulakan dengan Al-Fatihah — surah teragung, dibaca dalam setiap rakaat solat. Penawar dan pelindung.";
"manzil_fami_desc" = "Ungkapan mnemonik bermaksud \"mulutku sentiasa rindu (membaca Al-Quran)\". Tujuh huruf — ف م ي ب ش و ق — ialah huruf pertama bagi surah yang memulakan setiap Manzil: Al-Fatihah, Al-Ma'idah, Yunus, Al-Isra', Asy-Syu'ara, Ash-Shaffat, dan Qaf.";
"manzil_fami_label" = "Fami bi Syauqin (فَمِي بِشَوْقٍ)";
"manzil_header_body" = "Kumpulan ayat pilihan untuk perlindungan dari sihir, jin, dan gangguan, disusun oleh ulama di anak benua India.";
"manzil_header_title" = "Perlindungan dari Al-Quran";
"manzil_how_body" = "Setiap hari, bacalah satu Manzil secara berurutan dari Isnin hingga Ahad, bagi menamatkan seluruh Al-Quran dalam masa seminggu. Boleh dibaca dalam satu duduk atau dibahagikan kepada beberapa sesi sepanjang hari (contohnya selepas Subuh, Zohor, Asar, Maghrib, dan Isyak).\\n\\nUntuk bermula, mulakan dengan Manzil 1 (Juz 1–6) dan teruskan ke Manzil berikutnya setiap hari. Istiqamah adalah kunci — walaupun tidak dapat menyelesaikan satu Manzil penuh dalam sehari, usahakan sekurang-kurangnya membaca sebahagian dan teruskan keesokan harinya.";
"manzil_how_title" = "Cara Mengamalkan";
"manzil_info_definition" = "Manzil (bahasa Arab: منزل) ialah sistem pembahagian bacaan Al-Quran bagi memudahkan penyelesaian (khatam) Al-Quran dalam tempoh tujuh hari (seminggu). Tradisi ini lazim diamalkan dalam komuniti Muslim Asia Selatan dan dipopularkan oleh ulama seperti Syah Waliullah al-Dahlawi.\\n\\nNota: \"Manzil\" di sini merujuk kepada pembahagian 7 bahagian Al-Quran untuk khatam, dan adalah berbeza daripada ayat-ayat ruqyah perlindungan (Manzil ruqyah) yang dikumpulkan oleh Maulana Zakariyya Kandhlawi. Bahagian ini dalam aplikasi merangkumi ayat-ayat perlindungan.";
"manzil_info_subtitle" = "Definisi, pembahagian 7 hari & panduan amalan";
"manzil_info_title" = "Tentang Manzil Al-Quran";
