"manzil_benefits_list" = "Enables regular completion (khatam) of the Quran — once per week.|Builds a strong, consistent relationship with the Book of Allah.|Reciting the entire Quran regularly earns great reward and forgiveness.|Encourages daily reflection on different parts of the Quran.|A structured approach recommended by classical scholars and passed down through generations.";
"manzil_benefits_title" = "Virtues & Benefits";
"manzil_col_juz" = "Juz";
"manzil_col_manzil" = "Manzil";
"manzil_col_surah" = "Surah Range";
"manzil_desc_al_araf" = "Your Lord created the heavens and earth in six days — call upon Him humbly and in secret.";
"manzil_desc_al_falaq" = "Seek refuge with the Lord of daybreak from the evil of creation, darkness, sorcery, and envy.";
"manzil_desc_al_hasyr" = "If this Quran were sent upon a mountain, it would crumble — He is Allah, the Creator, the Bestower of Forms, the Most Beautiful Names.";
"manzil_desc_al_ikhlas" = "The essence of Tawheed — He is Allah, the One, the Eternal Refuge, who begets not nor is begotten.";
"manzil_desc_al_isra" = "Call upon Allah or Ar-Rahman — to Him belong the Most Beautiful Names. Praise be to Him who has no son nor partner.";
"manzil_desc_al_jinn" = "A group of jinn heard the Quran, believed, and declared their faith — our Lord has no spouse or child.";
"manzil_desc_al_kafirun" = "A declaration of disavowal from disbelief — to you your religion, to me mine.";
"manzil_desc_al_muminun" = "Were you created without purpose? Exalted is Allah, the True King — seek His forgiveness and mercy.";
"manzil_desc_ali_imran_18" = "Allah testifies that there is no deity but Him — the Almighty, the All-Wise.";
"manzil_desc_ali_imran_26" = "Say: O Allah, Owner of sovereignty — You give honour and power to whom You will.";
"manzil_desc_ali_imran_27" = "You cause the night to enter the day and bring the living from the dead — You provide for whom You will without measure.";
"manzil_desc_an_nas" = "Seek refuge with the Lord of mankind, the King of mankind, from the whisperer who withdraws.";
"manzil_desc_ar_rahman" = "O assembly of jinn and men — none can escape Allah's authority. Which of your Lord's favours will you deny?";
"manzil_desc_ash_shaffat" = "By the angels ranged in rows — your God is One, Lord of the heavens and the earth.";
"manzil_desc_ayat_kursi" = "The greatest verse in the Quran — a fortress of protection. Whoever recites it at night remains under Allah's protection until morning.";
"manzil_desc_baqarah_1" = "Continue with the opening of Al-Baqarah — guidance for the God-conscious and the path to success.";
"manzil_desc_baqarah_163" = "Your God is One — there is no deity but Him, the Most Gracious, the Most Merciful.";
"manzil_desc_baqarah_256" = "There is no compulsion in religion — truth has become clear from falsehood.";
"manzil_desc_baqarah_257" = "Allah is the Protector of the believers, bringing them from darkness into light.";
"manzil_desc_baqarah_284" = "To Allah belongs all that is in the heavens and earth — He will call you to account for what is in your hearts.";
"manzil_desc_baqarah_285" = "The Messenger and believers have faith in what was revealed — we hear and we obey, seeking Your forgiveness.";
"manzil_desc_baqarah_286" = "Allah does not burden a soul beyond its capacity — the closing supplication of Al-Baqarah for forgiveness and help.";
"manzil_desc_fatihah" = "Begin Manzil with Al-Fatihah — the greatest surah, recited in every rakah. A cure and protection.";
"manzil_fami_desc" = "A mnemonic phrase meaning \"My mouth longs to recite (the Quran)\". The 7 letters — ف م ي ب ش و ق — are the first letters of the surah that begins each of the 7 Manzils: Al-Fatihah, Al-Ma'idah, Yunus, Al-Isra', Ash-Shu'ara, Ash-Shaffat, and Qaf.";
"manzil_fami_label" = "Fami bi Shawqin (فَمِي بِشَوْقٍ)";
"manzil_header_body" = "A collection of selected verses for protection from sihr, jinn, and harm, compiled by scholars in the Indian subcontinent.";
"manzil_header_title" = "Protection from the Quran";
"manzil_how_body" = "Each day, recite one Manzil in sequence from Monday to Sunday, completing the entire Quran in one week. You may recite it in one sitting or spread it across multiple sessions during the day (e.g. after Fajr, Zuhr, Asr, Maghrib, and Isya').\n\nTo begin, start with Manzil 1 (Juz 1–6) and proceed to the next Manzil each day. Consistency is key — even if you cannot complete a full Manzil in a day, try to at least read a portion and continue the next day.";
"manzil_how_title" = "How to Practice";
"manzil_info_definition" = "Manzil (Arabic: منزل) is a system for dividing the recitation of the Quran to facilitate completing (khatam) the Quran over seven days (one week). This tradition is widely practiced in South Asian Muslim communities and has been popularized by scholars such as Shah Waliullah al-Dehlawi.\n\nNote: \"Manzil\" here refers to the 7-part Quran division for khatam, and is different from the protection verses (Manzil ruqyah) compiled by Maulana Zakariyya Kandhlawi. This section in the app covers the protection verses.";
"manzil_info_subtitle" = "Definition, 7-day division & practice guide";
"manzil_info_title" = "About Manzil Al-Quran";
