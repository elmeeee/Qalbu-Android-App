"manzil_benefits_list" = "Memungkinkan khataman Al-Quran secara rutin — satu kali per minggu.|Membangun hubungan yang kuat dan konsisten dengan Kitab Allah.|Membaca keseluruhan Al-Quran secara teratur mendatangkan pahala yang besar dan ampunan.|Mendorong tadabbur harian pada berbagai bagian Al-Quran.|Pendekatan terstruktur yang direkomendasikan oleh ulama klasik dan diwariskan turun-temurun.";
"manzil_benefits_title" = "Keutamaan & Manfaat";
"manzil_col_juz" = "Juz";
"manzil_col_manzil" = "Manzil";
"manzil_col_surah" = "Rentang Surah";
"manzil_desc_al_araf" = "Tuhanmu menciptakan langit dan bumi dalam enam masa — serulah Dia dengan rendah hati dan sembunyi.";
"manzil_desc_al_falaq" = "Berlindung kepada Tuhan Subuh dari kejahatan makhluk, malam gelap, sihir, dan iri hati.";
"manzil_desc_al_hasyr" = "Jika Quran ini diturunkan ke atas gunung, niscaya ia akan runtuh — Dialah Allah, Pencipta, Pembentuk Rupa, Nama-Nama Terindah.";
"manzil_desc_al_ikhlas" = "Intisari Tauhid — Dialah Allah, Maha Esa, Tempat Bergantung, tidak beranak dan tidak dilahirkan.";
"manzil_desc_al_isra" = "Serulah Allah atau Ar-Rahman — milik-Nya Nama-Nama Terindah. Segala puji bagi-Nya yang tidak beranak dan tidak bersekutu.";
"manzil_desc_al_jinn" = "Serombongan jin mendengar Quran, beriman, dan menyatakan iman mereka — Tuhan kami tidak beristri dan tidak beranak.";
"manzil_desc_al_kafirun" = "Pernyataan pemutusan dari kekafiran — bagimu agamamu, bagiku agamaku.";
"manzil_desc_al_muminun" = "Apakah kamu diciptakan tanpa tujuan? Maha Tinggi Allah, Raja Sejati — mohon ampunan dan rahmat-Nya.";
"manzil_desc_ali_imran_18" = "Allah bersaksi tiada tuhan selain Dia — Yang Maha Perkasa, Maha Bijaksana.";
"manzil_desc_ali_imran_26" = "Katakanlah: Wahai Allah, Pemilik kerajaan — Engkau memberi kemuliaan kepada siapa yang Engkau kehendaki.";
"manzil_desc_ali_imran_27" = "Engkau masukkan malam ke siang dan hidup dari yang mati — Engkau memberi rezeki tanpa hisab.";
"manzil_desc_an_nas" = "Berlindung kepada Tuhan manusia, Raja manusia, dari bisikan setan yang bersembunyi.";
"manzil_desc_ar_rahman" = "Wahai jin dan manusia — tiada yang lolos dari kekuasaan Allah. Maka nikmat Tuhanmu yang manakah yang kamu dustakan?";
"manzil_desc_ash_shaffat" = "Demi malaikat yang berbaris dalam saf — Tuhanmu Maha Esa, Rabb langit dan bumi.";
"manzil_desc_ayat_kursi" = "Ayat teragung dalam Al-Quran — benteng perlindungan. Siapa membacanya di malam hari akan tetap dalam perlindungan Allah hingga pagi.";
"manzil_desc_baqarah_1" = "Lanjutkan dengan awal Al-Baqarah — petunjuk bagi yang bertakwa dan jalan menuju kesuksesan.";
"manzil_desc_baqarah_163" = "Tuhanmu Maha Esa — tiada tuhan selain Dia, Maha Pengasih, Maha Penyayang.";
"manzil_desc_baqarah_256" = "Tidak ada paksaan dalam agama — kebenaran telah nyata dari kesesatan.";
"manzil_desc_baqarah_257" = "Allah Pelindung orang-orang beriman, mengeluarkan mereka dari kegelapan kepada cahaya.";
"manzil_desc_baqarah_284" = "Milik Allah apa yang di langit dan bumi — Dia akan memperhitungkan apa yang ada di hatimu.";
"manzil_desc_baqarah_285" = "Rasul dan orang beriman beriman pada wahyu — kami dengar dan kami taat, mohon ampunan-Mu.";
"manzil_desc_baqarah_286" = "Allah tidak membebani jiwa melampaui kemampuannya — doa penutup Al-Baqarah memohon ampunan dan pertolongan.";
"manzil_desc_fatihah" = "Bacaan Manzil dimulai dengan Al-Fatihah — surah teragung, dibaca di setiap rakaat sholat. Penyembuh dan pelindung.";
"manzil_fami_desc" = "Ungkapan kunci yang berarti \"mulutku selalu rindu (membaca Al-Quran)\". Tujuh huruf — ف م ي ب ش و ق — adalah huruf awal dari surah yang memulai setiap Manzil: Al-Fatihah, Al-Ma'idah, Yunus, Al-Isra', Asy-Syu'ara, Ash-Shaffat, dan Qaf.";
"manzil_fami_label" = "Fami bi Syauqin (فَمِي بِشَوْقٍ)";
"manzil_header_body" = "Kumpulan ayat pilihan untuk perlindungan dari sihir, jin, dan gangguan, disusun oleh ulama di anak benua India.";
"manzil_header_title" = "Perlindungan dari Al-Quran";
"manzil_how_body" = "Setiap hari, bacalah satu Manzil secara berurutan dari Senin hingga Minggu, sehingga khatam Al-Quran dalam satu minggu. Boleh dibaca dalam satu dudukan atau dibagi dalam beberapa sesi sepanjang hari (misalnya setelah Subuh, Zuhur, Asar, Maghrib, dan Isya').\\n\\nUntuk memulai, bacalah Manzil 1 (Juz 1–6) dan lanjutkan ke Manzil berikutnya setiap hari. Istiqamah adalah kuncinya — meskipun tidak bisa menyelesaikan satu Manzil penuh dalam sehari, usahakan minimal membaca sebagian dan lanjutkan keesokan harinya.";
"manzil_how_title" = "Cara Mengamalkan";
"manzil_info_definition" = "Manzil (bahasa Arab: منزل) adalah sistem pembagian pembacaan Al-Quran untuk memudahkan penyelesaian (khataman) Al-Quran selama tujuh hari (seminggu). Tradisi ini umum dipraktikkan di komunitas Muslim Asia Selatan dan dipopulerkan oleh ulama seperti Syah Waliullah al-Dahlawi.\\n\\nCatatan: \"Manzil\" di sini merujuk pada pembagian 7 bagian Al-Quran untuk khataman, berbeda dari ayat-ayat ruqyah perlindungan (Manzil ruqyah) yang dikumpulkan oleh Maulana Zakariyya Kandhlawi. Bagian ini dalam aplikasi membahas ayat-ayat perlindungan.";
"manzil_info_subtitle" = "Definisi, pembagian 7 hari & panduan amalan";
"manzil_info_title" = "Tentang Manzil Al-Quran";
