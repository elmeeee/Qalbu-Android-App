# Local secrets for Al-Khatib / SĀAT Android.
# Copy this file to local.properties and fill in. local.properties is gitignored.
#

# Quran Foundation OAuth client secrets (per environment).
# Used for the Basic auth header on token exchange + refresh.
QF_OAUTH_CLIENT_SECRET_DEBUG=
QF_OAUTH_CLIENT_SECRET_RELEASE=

# Groq API key (optional — drives AI reflection drafting on Today tab).
API_KEY_GROQ=
AI_MODEL=qwen/qwen3-32b

# Release signing (Play Store upload). Paths are relative to project root.
# Generate with: keytool -genkeypair -v -keystore keystore/saat-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias saat
RELEASE_STORE_FILE=keystore/saat-release.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=saat
RELEASE_KEY_PASSWORD=

# Note: User OAuth scopes (build.gradle QF_OAUTH_SCOPES) must include `reading_session` for continue-reading.
# Client-credentials scopes (AppConfig.qfClientCredentialsScopes) must include `content` for chapters/verses.
# Search API uses the same content token — do not add `search` to client_credentials unless enabled on QF dashboard.
# After changing scopes on the QF dashboard, sign out + sign in again so a new refresh_token is issued.
